{
  "name": "flowdesc",
  "private": true,
  "version": "0.0.0",
  "description": "Collaborative project/workflow management platform for small engineering teams.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:plain": "pnpm --parallel --filter \"./apps/*\" --filter \"./packages/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @flowdesc/contracts build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:prod": "pnpm build && playwright test -c e2e/playwright.prod.config.ts",
    "test:e2e:ui": "pnpm --filter @flowdesc/contracts build && playwright test -c e2e/playwright.config.ts --ui",
    "prepare": "husky",
    "db:generate": "pnpm --filter @flowdesc/api db:generate",
    "db:migrate": "pnpm --filter @flowdesc/api db:migrate",
    "db:seed": "pnpm --filter @flowdesc/api db:seed",
    "db:seed:demo": "pnpm --filter @flowdesc/api db:seed:demo",
    "landing:shots": "node e2e/scripts/capture-landing.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "figlet": "^1.11.4",
    "husky": "^9.1.7",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
